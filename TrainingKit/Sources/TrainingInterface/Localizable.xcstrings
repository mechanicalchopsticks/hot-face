        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completaste el escalón de repeticiones. Sube la carga y vuelve al escalón anterior."
          }
        }
      }
    },
    "At 15 repetitions, move to the next load with 10 repetitions." : {
      "localizations" : {
